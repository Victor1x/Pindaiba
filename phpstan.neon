includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app/
        - routes/
        - database/factories
        - database/seeders

    excludePaths:
        - app/**/*.blade.php
        - vendor/*
        - bootstrap/cache/*
        - storage/*

    reportUnmatchedIgnoredErrors: true
